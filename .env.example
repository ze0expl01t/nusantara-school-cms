APP_NAME="Nusantara School CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

ADMIN_APP_PATH=admin
HORIZON_PATH=horizon

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nusantara_cms
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
CACHE_PREFIX=nusantara_cache_
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=nusantara_redis_
REDIS_CACHE_PREFIX=nusantara_cache_

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@example.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

BACKUP_MAIL_TO="admin@example.sch.id"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

IMAGE_PROXY_DRIVER=gd
IMAGE_PROXY_SOURCE_DISK=public
IMAGE_PROXY_CACHE_DISK=local
IMAGE_PROXY_PATH=img
IMAGE_PROXY_SIGNING_ENABLED=false
IMAGE_PROXY_LOG=false
IMAGE_PROXY_LOG_CHANNEL=stack

ANALYTICS_PROPERTY_ID=

COMPOSER_HOME=~/.config/composer

VITE_APP_NAME="${APP_NAME}"
